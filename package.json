{
  "name": "quotastation",
  "private": true,
  "version": "1.2.0",
  "description": "Windows app for tracking AI coding quotas, usage, reset times, and estimated API costs",
  "license": "AGPL-3.0-only",
  "author": "Steve Wang <contact@stevewang.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteveWang92/QuotaStation.git"
  },
  "bugs": {
    "url": "https://github.com/SteveWang92/QuotaStation/issues"
  },
  "homepage": "https://github.com/SteveWang92/QuotaStation#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check:core": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:core": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "coverage:core": "cargo llvm-cov --locked --manifest-path src-tauri/Cargo.toml --summary-only",
    "fmt:core": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format:core": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint:core": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "verify": "npm run lint && npm test && npm run build && npm run fmt:core && npm run lint:core && npm run test:core",
    "lint": "biome check",
    "format": "biome check --write",
    "tauri": "tauri",
    "build:debug": "tauri build --debug --no-bundle",
    "build:release": "tauri build --no-bundle",
    "build:installer": "tauri build --bundles nsis",
    "icons": "node scripts/icons.mjs",
    "release:prep": "changedeck prep",
    "release:reversion": "changedeck reversion",
    "release:ship": "changedeck ship"
  },
  "engines": {
    "node": "24.18.1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}

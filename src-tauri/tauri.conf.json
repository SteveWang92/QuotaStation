{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaStation",
  "version": "0.1.0",
  "identifier": "me.stevewang.quotastation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuotaStation",
        "width": 1280,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Steve Wang",
    "copyright": "Copyright © 2026 Steve Wang",
    "shortDescription": "Local-first AI quota and usage monitoring",
    "longDescription": "QuotaStation monitors Codex quota windows and local usage history without uploading private session data.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

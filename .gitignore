# -----------------------------------------------------------------------------
# Allowlist-style ignore: everything at the repository root is ignored by default and
# only reviewed paths are un-ignored below. A new top-level file or directory stays
# invisible to git until it is deliberately added here — fail-closed, so a stray
# credential or private config cannot be committed by accident.
# -----------------------------------------------------------------------------
/*

# --- Tracked directories ---
!/.cargo/
!/.github/
!/.vscode/
!/docs/
!/scripts/
!/src/
!/src-tauri/
!/tests/
!/vendor/

# --- Tracked root files ---
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.nvmrc
!/AGENTS.md
!/biome.jsonc
!/changedeck.json
!/CHANGELOG.md
!/CLAUDE.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/index.html
!/LICENSE
!/package-lock.json
!/package.json
!/README.md
!/rustfmt.toml
!/SECURITY.md
!/SUPPORT.md
!/THIRD_PARTY_NOTICES.md
!/tsconfig.json
!/tsconfig.node.json
!/vite.config.ts

# --- Never track, anywhere in the tree ---
# Local-only files must use the .local marker.
*.local
*.local.*

# Environment and secrets
.env
.env.*
!.env.example

# Dependencies and generated output
node_modules/
# Tauri regenerates the capability and permission schemas on every build.
src-tauri/gen/
dist/
build/
coverage/
out/
target/
# Every packaged build is kept here, one entry per version. They are large binaries and
# belong on release pages rather than in the history.
release/

# Tool caches
.cache/
.parcel-cache/
.turbo/
.vite/
*.tsbuildinfo

# Editors and operating systems
.idea/
# Two files under .vscode/ are shared on purpose: they point every contributor's
# editor at this repository's own Biome and rustfmt instead of a global formatter.
# Everything else there is personal.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

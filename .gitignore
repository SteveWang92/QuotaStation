# Local-only files must use the .local marker.
*.local
*.local.*

# Environment and secrets
.env
.env.*
!.env.example

# Dependencies and generated output
node_modules/
# Tauri regenerates the capability and permission schemas on every build.
src-tauri/gen/
dist/
build/
coverage/
out/
target/

# Tool caches
.cache/
.parcel-cache/
.turbo/
.vite/
*.tsbuildinfo

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

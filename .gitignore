# Local-only files must use the .local marker.
*.local
*.local.*

# Environment and secrets
.env
.env.*
!.env.example

# Dependencies and generated output
node_modules/
# Tauri regenerates the capability and permission schemas on every build.
src-tauri/gen/
dist/
build/
coverage/
out/
target/
# Every packaged build is kept here, one entry per version. They are large binaries and
# belong on release pages rather than in the history.
release/

# Tool caches
.cache/
.parcel-cache/
.turbo/
.vite/
*.tsbuildinfo

# Editors and operating systems
.idea/
# Two files under .vscode/ are shared on purpose: they point every contributor's
# editor at this repository's own Biome and rustfmt instead of a global formatter.
# Everything else there is personal.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
